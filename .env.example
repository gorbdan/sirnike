BOT_TOKEN=
IMGBB_API_KEY=
PROVIDER_TOKEN=

# Pick one provider: YESAPI, MASHAGPT, or ZVENO.
AI_PROVIDER=YESAPI

# YESAPI / Nano Banana
NANO_API_BASE=https://api.yesai.su/v2/google/nanobanana
NANO_API_KEY=

# MashaGPT
MASHAGPT_API_BASE=https://api.mashagpt.ru
MASHAGPT_API_KEY=
MASHAGPT_IMAGE_MODEL=nano-banana-pro
MASHAGPT_CHAT_MODEL=gpt-4o-mini

# ZvenoAI
ZVENO_API_BASE=https://api.zveno.ai/v1
ZVENO_API_KEY=
# Nano Banana 2 — дефолт с 2026-06-11 (в ~8 раз дешевле Pro при сравнимом качестве)
ZVENO_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
ZVENO_CHAT_MODEL=google/gemini-2.5-flash

PROMPT_WEBAPP_URL=

# BotHost sets this in the generated Dockerfile. Keep it for local Docker runs too.
DATA_DIR=/app/data
BOT_LOG_DIR=/app/data

KLING_API_BASE=https://api.yesai.su/v2/yesvideo
KLING_VERSION=1.6
KLING_DURATION=10
KLING_DIMENSIONS=16:9
KLING_VIDEO_COST=5
KLING_MAX_POLL_ATTEMPTS=80
KLING_POLL_INTERVAL=15

KLING_MOTION_ENDPOINT=/v1/tasks/kling-2-6-motion-control
KLING_MOTION_VERSION=2.6-pro
KLING_MOTION_COST=5
KLING_MOTION_MODE=720p
KLING_MOTION_ORIENTATION=video
KLING_MOTION_DURATION=10
KLING_MOTION_MAX_POLL_ATTEMPTS=80
KLING_MOTION_POLL_INTERVAL=15
MOTION_CONTROL_ENABLED=0

SEEDANCE_ENABLED=1
SEEDANCE_ENDPOINT=/v1/videos
SEEDANCE_MODEL=bytedance/seedance-2.0
SEEDANCE_COST=5
SEEDANCE_MODE=720p
SEEDANCE_DURATION=5
SEEDANCE_DURATION_OPTIONS=5,10,15
SEEDANCE_COST_PER_SECOND=7.0
SEEDANCE_MAX_POLL_ATTEMPTS=80
SEEDANCE_POLL_INTERVAL=15

SEEDANCE_FAST_ENABLED=1
SEEDANCE_FAST_ENDPOINT=/v1/videos
SEEDANCE_FAST_MODEL=bytedance/seedance-2.0-fast
SEEDANCE_FAST_MODE=720p
SEEDANCE_FAST_DURATION_OPTIONS=5,10,15
SEEDANCE_FAST_COST_PER_SECOND=3.0

# Kling 3.0 через Zveno Videos API (text-to-video + image-to-video, 720p)
# Закупка Zveno 12.10 руб/сек -> 8.0 изюм/сек = маржа ~x3.3 (как у Seedance)
KLING3_ENABLED=1
KLING3_MODEL=kwaivgi/kling-v3.0-std
KLING3_COST_PER_SECOND=8.0
KLING3_DURATION_OPTIONS=3,5,10,15

# Veo 3.1 Fast (Google) через Zveno Videos API (только 4/6/8 сек, 720p, 16:9/9:16)
# Закупка Zveno 12.21 руб/сек (без аудио) -> 8.0 изюм/сек
VEO31_ENABLED=1
VEO31_MODEL=google/veo-3.1-fast
VEO31_COST_PER_SECOND=8.0
VEO31_DURATION_OPTIONS=4,6,8

# Wan 2.7 (Alibaba) через Zveno Videos API (text-to-video + image/reference-to-video,
# 2-10 сек, 480p/720p, 16:9/9:16)
# Закупка Zveno 16.21 руб/сек -> 10.0 изюм/сек = маржа ~x3.3
WAN27_ENABLED=1
WAN27_MODEL=alibaba/wan-2.7
WAN27_COST_PER_SECOND=10.0
WAN27_DURATION_OPTIONS=5,10

# GPT-5 Image (OpenAI) через Zveno — вторая модель картинок рядом с Gemini
# Закупка ~12-30 руб/картинка -> 10 изюминок, иначе маржа около нуля
GPT5_IMAGE_ENABLED=1
ZVENO_GPT5_IMAGE_MODEL=openai/gpt-5-image
GPT5_IMAGE_COST=10

START_BONUS=5
REFERRAL_BONUS_REFERRER=10
REFERRAL_BONUS_NEW_USER=5
FREE_GENERATIONS_PER_DAY=0
BASE_GENERATION_COST=5
REFERENCE_COST=0
MAX_POLL_ATTEMPTS=30
POLL_INTERVAL=60
ADMIN_IDS=320423776
